# Warrant's configuration. Copy to .env (gitignored) and fill in the
# placeholders there. Every credential is an angle-bracket placeholder in this
# file and a real value only in .env, which never enters git: a hook refuses a
# commit that stages it or adds a key-shaped line. A setting that is not a
# credential carries its real default, because a placeholder there would be
# copied into .env and then used as a value.

# The Keycloak admin console at http://localhost:8080, master realm. compose.yml
# refuses to start without it, and reads it from .env itself.
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>

# The password for the three dev-only realm users alice, bob, and mallory. The
# realm import in infra/keycloak/warrant-realm.json reads it as
# ${WARRANT_USER_PASSWORD}, so the committed realm file carries the placeholder
# and the value lives only here. One password for all three is a local-stack
# shortcut, not a claim about how they differ.
WARRANT_USER_PASSWORD=<your-dev-user-password>

# The client secret shared by the three dev-only confidential agent clients
# (triage-agent, support-agent, orphan-agent). Same mechanism: the realm file
# says ${WARRANT_AGENT_CLIENT_SECRET}. One secret for all three is a
# local-stack shortcut; a real deployment gives each client its own.
WARRANT_AGENT_CLIENT_SECRET=<your-dev-agent-client-secret>

# Gitea's admin token. The gitea MCP server (W3) and scripts/gitea_bootstrap.py
# read it from this file through the settings object, the same way the realm
# reads its placeholders.
GITEA_ADMIN_TOKEN=<your-gitea-admin-token>

# The local Gitea the gitea MCP server and scripts/gitea_bootstrap.py talk to.
# Not a credential, so the real default is here.
GITEA_URL=http://localhost:3000

# Which forge the gitea MCP server is written against. `gitea` is the local
# compose forge; `github` is the throwaway org W21 adds. Not a credential.
FORGE=gitea

# The superuser password for the postgres MCP server's local database (W8). Read
# by that server's process, and by compose.yml once the postgres service lands.
POSTGRES_PASSWORD=<your-postgres-password>

# The DeepSeek cloud API key, used by every model call in the project. The dsh
# harness resolves it at request time from the launching shell, then
# $DSH_HOME/.credentials.yaml, then this file, so a copy here is the last of the
# three and not what the runner reads. See docs/decisions/000-harness.md.
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# The Linear API key, for reading issues with the linear CLI. Read from the
# launching shell, or from the gitignored .linear.toml, never by the service.
LINEAR_API_KEY=<your-linear-api-key>

# Reserved for the agent slice: the model the agent under test runs as, and the
# model that adjudicates what it did. Both name the cloud model; the suffix is
# the reasoning effort. No code reads these yet, so the defaults below are the
# intended ones rather than the effective ones. The runner's own defaults are in
# scripts/dsh_run.py.
WARRANT_MODEL=deepseek:deepseek-flash@off
ADJUDICATOR_MODEL=deepseek:deepseek-flash@max
