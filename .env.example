# Warrant's configuration. Copy to .env (gitignored) and fill in the
# placeholders there. Every credential is an angle-bracket placeholder in this
# file and a real value only in .env, which never enters git: a hook refuses a
# commit that stages it or adds a key-shaped line.

# The Keycloak admin console at http://localhost:8080, master realm. compose.yml
# refuses to start without it.
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>

# Gitea's admin token, used by the gitea MCP server (W3).
GITEA_ADMIN_TOKEN=<your-gitea-admin-token>

# The superuser password for the postgres MCP server's local database (W8).
POSTGRES_PASSWORD=<your-postgres-password>

# The DeepSeek cloud API key. The dsh harness and every model call in this
# project read this one key.
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# The Linear API key, for reading issues. Not read by the service.
LINEAR_API_KEY=<your-linear-api-key>

# The model the agent under test runs as, and the model that adjudicates what
# it did. Both name the cloud model; the suffix is the reasoning effort.
# Override per run on the command line rather than editing these.
WARRANT_MODEL=deepseek:deepseek-flash@off
ADJUDICATOR_MODEL=deepseek:deepseek-flash@max
