# Warrant's configuration. Copy to .env (gitignored) and fill in the
# placeholders there. Every credential is an angle-bracket placeholder in this
# file and a real value only in .env, which never enters git: a hook refuses a
# commit that stages it or adds a key-shaped line. A setting that is not a
# credential carries its real default, because a placeholder there would be
# copied into .env and then used as a value.

# The Keycloak admin console at http://localhost:8080, master realm. compose.yml
# refuses to start without it, and reads it from .env itself.
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>

# The password for the three dev-only realm users alice, bob, and mallory. The
# realm import in infra/keycloak/warrant-realm.json reads it as
# ${WARRANT_USER_PASSWORD}, so the committed realm file carries the placeholder
# and the value lives only here. One password for all three is a local-stack
# shortcut, not a claim about how they differ.
WARRANT_USER_PASSWORD=<your-dev-user-password>

# The client secret shared by the three dev-only confidential agent clients
# (triage-agent, support-agent, orphan-agent) and the gateway's warrant client.
# Same mechanism: the realm file says
# ${WARRANT_AGENT_CLIENT_SECRET}. One secret for all of them is a
# local-stack shortcut; a real deployment gives each client its own.
WARRANT_AGENT_CLIENT_SECRET=<your-dev-agent-client-secret>

# Gitea's admin token. The gitea MCP server (W3) and scripts/gitea_bootstrap.py
# read it from this file through the settings object, the same way the realm
# reads its placeholders.
GITEA_ADMIN_TOKEN=<your-gitea-admin-token>

# The local Gitea the gitea MCP server and scripts/gitea_bootstrap.py talk to.
# Not a credential, so the real default is here.
GITEA_URL=http://localhost:3000

# Which forge the gitea MCP server is written against. `gitea` is the local
# compose forge; `github` is the throwaway org W21 adds. Not a credential.
FORGE=gitea

# The postgres MCP server's database (W8). The password is the one credential
# compose interpolates for the `postgres` service; the user, database, host, and
# port are settings, so they carry their real values. The server holds this role
# with full read and write on the support schema on purpose; see
# servers/postgres_mcp/server.py for why the role is broad and why that is not
# the guard.
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_USER=warrant
POSTGRES_DB=support
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The mail MCP resource server over Mailpit (W9). No credential: Mailpit accepts
# anything on the local stack, so these are endpoints and one address. SMTP is on
# 1025 and the HTTP API and web UI on 8025. MAIL_FROM is the address every reply
# is sent from, and the one `inspect.sent_messages` filters sent mail by. Compose
# overrides the host and the Mailpit URL for the service it runs.
MAIL_URL=http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=support@acme.test

# The DeepSeek cloud API key, used by every model call in the project. The dsh
# harness resolves it at request time from the launching shell, then
# $DSH_HOME/.credentials.yaml, then this file, so a copy here is the last of the
# three and not what the runner reads. See docs/decisions/000-harness.md.
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# The Linear API key, for reading issues with the linear CLI. Read from the
# launching shell, or from the gitignored .linear.toml, never by the service.
LINEAR_API_KEY=<your-linear-api-key>

# --- W24 and W26, the Jev classifier ----------------------------------------
# The Jev System One endpoint. `JEV_API_KEY` is the one credential, and the
# callers that read it are the `jev`, `cascade`, and `jev-only` ablations and
# the `ADJUDICATOR=jev` adjudicator: the key never enters a commit or a run
# record, and the state sent to the endpoint is seeded scenario data. The rest
# are settings with their real defaults, so only the key is a placeholder.
# `JEV_DERIVED_THRESHOLD` is the probability at or above which the `jev` rule
# reports a write as derived from untrusted content.
JEV_API_KEY=<your-jev-api-key>
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_DERIVED_THRESHOLD=0.5
JEV_TIMEOUT_S=30

# The model the agent under test runs as, and the model that adjudicates what
# it did. Both name the cloud model; the suffix is the reasoning effort.
# WARRANT_MODEL is read by the agent's provider and ADJUDICATOR_MODEL by
# `warrant.adjudicator`, so the two can run at different efforts. The
# adjudicator's output cap and the wall clock one adjudication may take before
# the call defers to the human queue are settings, not credentials, so their
# real defaults are here. The runner's own defaults are in scripts/dsh_run.py.
WARRANT_MODEL=deepseek:deepseek-flash@off
ADJUDICATOR_MODEL=deepseek:deepseek-flash@max
ADJUDICATOR_MAX_TOKENS=8192
ESCALATION_TIMEOUT_S=900

# W26. Which adjudicator answers an escalation: `deepseek` is W16's generated
# verdict, `jev` the typed-selection one that cites by choosing from the
# ledger. One run selects one adjudicator, so both answer the same escalation
# in a comparison. `ADJUDICATOR_MODEL` and the output cap above apply to the
# `deepseek` choice only. An unrecognized value stops the process rather than
# falling back.
ADJUDICATOR=deepseek

# The ablation mode and the provenance taint. `WARRANT_MODE` picks the request
# path (`full`, `no-provenance`, `no-exchange`, `prompt-only`, `jev-only`) and
# `TAINT` picks which provenance rule the gateway computes (`task`, `content`,
# `both`, `jev`). Neither is a credential, so the real defaults are here. `full`
# with `both` is the shipped configuration; W15 sets `TAINT=content` for the
# content-taint ablation and W24 sets `TAINT=jev` or `WARRANT_MODE=jev-only` for
# the two Jev ablations. An unrecognized value for either stops the process
# rather than falling back.
WARRANT_MODE=full
TAINT=both

# --- W6, the MCP gateway ----------------------------------------------------
# The one endpoint the agents connect to. `agents/mcp_client.py` reads it and
# `agents/triage.py` hands it to the exchange, so an agent reaches the gateway
# and nothing upstream. Not a credential, so the real default is here. W6 also
# reuses WARRANT_AGENT_CLIENT_SECRET above for the gateway client.
WARRANT_URL=http://localhost:9100/mcp

# Where every run writes: the decision log, the provenance ledger, the run
# metadata, and `dsh/` for harness costs. Absolute, because a relative path
# resolves against the process's working directory and a run started from a
# worktree would write into that worktree instead. The code's default is the
# main checkout's `runs/`, resolved from the running file's own location, so
# this line is here to show the name and to make the override visible. Set it
# to point a run at an eval column.
# WARRANT_RUNS_DIR=/Users/you/proj/warrant/runs

# The host directory compose bind-mounts at `/app/runs`. The Makefile exports an
# absolute main-checkout path derived from `scripts/repo_root.sh`, so a stack
# started from a worktree still mounts the same runs directory the scenario
# seeder writes. The value here is what a bare `docker compose` uses when the
# Makefile is not involved; compose resolves it against the compose project
# directory.
WARRANT_RUNS_HOST_DIR=./runs

# The access graph the scenario seeder writes and the gateway reads. The compose
# warrant service sets `/app/runs/graph/warrant.db`, and the seeder's default is
# the main checkout's `runs/graph/warrant.db`, which is the same file because the
# mount above is absolute from `make up`. The eval runner runs the gateway in
# compose, so a gateway started by hand on the host without this variable is out
# of scope: the seeder and the compose gateway must name one file, or a
# scenario's agents and resource rows never reach the process that decides on
# them. Set it only to point both at one shared path.
# WARRANT_GRAPH_DB=/Users/you/proj/warrant/runs/graph/warrant.db

# The provenance of a run, for a process with no git. The container image has
# no git and no `.git`, so `warrant/config.py` reads these when `git rev-parse`
# cannot answer and writes the values into the run's `metadata.json`. The smoke
# procedure exports them from the checkout and passes them on the run command,
# so they are named here rather than set: a commit sha has no real default, and
# an empty assignment would copy "no commit" into `.env` as though it were one.
# WARRANT_COMMIT=<the commit sha the run was started from>
# WARRANT_DIRTY=<true or false, whether the checkout had uncommitted changes>

# --- later issues, commented until the issue that needs them ----------------
# Each block names the variables that issue will read. They are comments
# because nothing reads them yet, and an uncommented name with no reader would
# read as configuration that is already in force.
#
# W22, the second model family, reads no variable here. The local route is a
# fixed row in `agents/providers/__init__.py` (`qwen-local`, base URL
# `http://localhost:11434/v1`) and it takes no credential, so the runner names
# it on `--models` as `qwen-local:qwen3.8:27b@off` and starts.
