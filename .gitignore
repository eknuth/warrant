# secrets
.env
.env.*
!.env.example
.linear.toml

# local
.venv/
__pycache__/
runs/
.DS_Store

# the grader's fixture runs are hand-written inputs, not run output, and the
# `runs/` rule above would otherwise swallow them
!tests/fixtures/runs/
!tests/fixtures/runs/**

# worktrees for verifying a pull request, for an eval run pinned to a commit,
# and for the recording. They live inside the checkout, so this is what keeps
# each one's copy of the tree out of the main checkout's status.
.worktrees/

# the access graph, rebuilt from infra/graph.yml by `python -m warrant.graph load`
warrant.db

# tool caches
.pytest_cache/
.ruff_cache/
*.pyc

# eval output: one directory per column, rewritten by every run. W14 writes
# here and W15 renders from here; nothing in it is hand-edited or committed.
evals/results/

# the checkout-local uv cache `make` sets by default
.uv-cache/

# docker buildx state, when a session points BUILDX_CONFIG into the checkout
.docker-buildx/
